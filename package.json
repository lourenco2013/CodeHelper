{
  "name": "codehelper",
  "version": "1.0.0",
  "description": "Assistente pessoal de programação",
  "main": "main.js",
  "author": "CodeHelper",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.codehelper.app",
    "productName": "CodeHelper",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.4.0"
  }
}